{
    "name":  "@pot/api",
    "version":  "1.0.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "dev":  "tsx watch src/server.ts",
                    "build":  "tsc -p tsconfig.json",
                    "start":  "node dist/server.js",
                    "typecheck":  "tsc -p tsconfig.json --noEmit",
                    "seed":  "tsx src/scripts/seed-personas.ts",
                    "backfill:tylo-vectors":  "tsx src/scripts/backfill-tylo-vectors.ts"
                },
    "dependencies":  {
                         "@pot/shared":  "1.0.0",
                         "cors":  "^2.8.6",
                         "dotenv":  "^18.0.9",
                         "express":  "^5.3.0",
                         "express-oauth2-jwt-bearer":  "^1.11.0",
                         "helmet":  "^8.3.0",
                         "mongoose":  "^9.11.4",
                         "morgan":  "^1.12.1"
                     },
    "devDependencies":  {
                            "@types/cors":  "^2.8.19",
                            "@types/express":  "^5.0.6",
                            "@types/morgan":  "^1.9.10",
                            "@types/node":  "^24.19.2",
                            "tsx":  "^4.23.15",
                            "typescript":  "^7.0.2"
                        }
}
